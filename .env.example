# Backend environment variables (backend/bin/server.dart, backend/lib/src/core/network/*).
# Copy this file to .env for local development and fill in real values.
# Never commit a real .env — this file only documents variable names.

# Postgres connection string: postgres://user:password@host:port/database
DATABASE_URL=

# Secret used to sign/verify JWTs. Generate a long random value for anything
# beyond local dev — the backend falls back to a weak default if unset.
JWT_SECRET=

# Port the server listens on. Hosting platforms (Render, etc.) usually inject
# this automatically — only set it yourself for local runs.
PORT=8080

# development | staging | production. Surfaced read-only at GET /health.
APP_ENV=development

# Comma-separated list of allowed browser origins for CORS, e.g.
# https://example.com,https://admin.example.com
# Leave unset for local dev — any http://localhost:* or http://127.0.0.1:*
# origin is allowed automatically in that case.
CORS_ORIGINS=

# "require" to enforce TLS to Postgres (needed for most managed Postgres
# providers, including Render). Leave unset/anything else to disable, which
# matches the local docker-compose Postgres (no TLS).
DB_SSL_MODE=
