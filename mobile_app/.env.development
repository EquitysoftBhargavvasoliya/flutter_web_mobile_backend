# On an emulator/simulator, localhost works as-is. On a real device, either:
#   - run `adb reverse tcp:8080 tcp:8080` and keep this as localhost, or
#   - replace with your dev machine's LAN IP (e.g. http://192.168.1.45:8080/api/v1)
#     and make sure Windows Firewall allows inbound connections to dart.exe.
API_BASE_URL=http://localhost:8080/api/v1
